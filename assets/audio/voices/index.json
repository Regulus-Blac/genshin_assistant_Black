    },
    {
      "file": "line03.mp3",
      "topic": "闲聊·文章",
      "text": "衣裓贮文章，自言学雕虫。",
      "source": "https://uploadstatic.mihoyo.com/ys-obc/2021/03/12/4359827/6fa04099a589b0f77ef4f42c4620fc81_2545126132988547582.mp3"
    },
    {
      "file": "line04.mp3",
      "topic": "闲聊·偷闲",
      "text": "正所谓「偷得浮生半日闲」，哈哈。",
